# Copy to .env and fill in. .env is gitignored and never baked into the image.
#
# EVERY variable the API and workers read goes here, including the ones with a
# default. The API validates its variables in apps/api/src/env.ts and the
# workers in apps/workers/src/lib/env.ts; a variable added there is added here
# in the same commit.
#
# Values are dummies of the right shape, set for local development against
# infra/docker-compose.yml.

# --- Core (api, workers) ---
# Required, no default. development mounts /dev routes and skips DNS lookups
# when verifying domains; production issues pst_live_ keys and sets Secure
# cookies.
NODE_ENV=development
PORT=3000

# --- Database (api, workers, migrate) ---
# Production: Neon EU (ADR-004). Local: infra/docker-compose.yml.
DATABASE_URL=postgresql://postly:postly@localhost:5432/postly_dev
# Where migrate finds the Drizzle migrations. The image sets /app/drizzle;
# locally the default (packages/db/drizzle) is right, so leave it unset.
# MIGRATIONS_DIR=

# --- Redis: BullMQ queues and the workers' health heartbeat ---
# Production compose overrides this with the redis service.
REDIS_URL=redis://localhost:6379

# --- API ---
# The dashboard's origin, allowed by CORS with credentials.
DASHBOARD_URL=http://localhost:5173

# --- Delivery: KumoMTA, our own MTA (ADR-020) ---
# Where the workers inject. In development infra/docker-compose.yml publishes
# kumod on 127.0.0.1:2525; in production it is the private listener on the host.
KUMO_SMTP_HOST=127.0.0.1
KUMO_SMTP_PORT=2525
# KumoMTA's HTTP listener, checked by /health (dev: 8010 on the host).
KUMO_HTTP_URL=http://127.0.0.1:8010
# Shared secret for /internal/*, which KumoMTA calls for DKIM keys and to
# report delivery events. kumod reads the same variable. Required.
# Generate: openssl rand -hex 24
INTERNAL_TOKEN=replace-with-48-random-hex-characters-0000000000
# Encrypts DKIM private keys at rest (AES-256-GCM). 32 bytes, base64. Required.
# Generate: openssl rand -base64 32. Losing it means re-keying every domain.
DKIM_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# --- Postly's own DNS, written into every customer's records ---
# SPF include listing the sending IPs, the MX that receives bounces, and the
# address in the recommended DMARC record. The defaults assume postly.eu.
POSTLY_SPF_INCLUDE=_spf.postly.eu
POSTLY_BOUNCE_MX=mx.postly.eu
POSTLY_DMARC_REPORTS=dmarc@postly.eu

# --- Deploy (production host only) ---
# The SHA-tagged image docker-compose.yml runs. Written by the deploy; do not
# hand-edit except to roll back.
# APP_IMAGE=ghcr.io/benbo-se/postly:<commit-sha>

# --- CLI (apps/cli), read from your shell, not by the server ---
# POSTLY_API_KEY=pst_test_...
# POSTLY_API_URL=http://localhost:3000
