{
  "name": "@postly/api",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "openapi:write": "tsx scripts/write-openapi.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@hono/zod-openapi": "^1.6.3",
    "@postly/db": "workspace:*",
    "@postly/shared": "workspace:*",
    "ajv": "^8.20.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.77.2",
    "hono": "^4.13.8",
    "ioredis": "^5.10.1",
    "mjml": "^5.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/mjml": "^5.0.0",
    "@types/node": "^22.15.0",
    "eslint": "^10.10.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  }
}
