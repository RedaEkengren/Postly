{
  "name": "postly",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev --filter=!@postly/cli",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:integration": "turbo test:integration --concurrency=1",
    "db:migrate": "tsx --env-file=.env apps/api/src/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed-dev.ts",
    "db:studio": "pnpm --filter @postly/db studio",
    "cli": "pnpm --filter @postly/cli dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@postly/db": "workspace:*",
    "bcrypt": "^6.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "tsx": "^4.22.3",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0"
  },
  "license": "Apache-2.0"
}
